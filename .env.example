# Copy to .env.local for local work. On Vercel, add each variable under
# Project → Settings → Environment Variables (Production and Preview), then
# redeploy. None of these are exposed to the browser: they are read only by
# the /api/rsvp route on the server.

# Service account that writes the RSVP answers. Create it in Google Cloud
# (IAM & Admin → Service Accounts), enable the Google Sheets API, create a JSON
# key, and share the spreadsheet with this email as an Editor.
GOOGLE_CLIENT_EMAIL=rsvp-writer@your-project.iam.gserviceaccount.com

# The "private_key" value from that JSON key. Keep the quotes and the \n
# sequences exactly as they appear in the file. In the Vercel dashboard you can
# paste it with or without the quotes; real line breaks work too.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_YOUR_KEY\n-----END PRIVATE KEY-----\n"

# The id in the spreadsheet URL: docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=your-spreadsheet-id

# Optional: the tab to write to. Leave empty to use the first tab. A header row
# is added automatically when the tab is empty.
GOOGLE_SHEET_TAB=
